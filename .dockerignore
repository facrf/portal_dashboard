# Controle de versão e metadados de desenvolvimento
.git
.github
.gitignore
.dockerignore
.agents
.codex

# Segredos e dados locais
.env
.env.*
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
db_data

# A coleção local é opcional e muito grande; imagens de CI devem ser determinísticas.
icons/*
!icons/.gitkeep
!icons/.htaccess

# Arquivos sem uso em tempo de execução
*.md
LICENSE

# Logs temporários de validação
.build-*.log
