# Controle de versão e metadados de desenvolvimento
.git
.github
.gitignore
.dockerignore
.agents
.codex
.vscode/
.idea/

# Segredos e dados de ambiente
.env
.env.*

# Banco de dados e locks locais
db_data
db_data/
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sql
*.dump
*.fdb
*.mdb
*.gdb
*.fbk
*.gbk
*.bak
*.migration.lock
*.lock

# A coleção local é opcional e muito grande; imagens de CI devem ser determinísticas.
icons/*
!icons/.gitkeep
!icons/.htaccess

# Arquivos sem uso em tempo de execução
*.md
LICENSE

# Logs temporários de validação e execução
*.log
.build-*.log
cookie.txt
*.cookie
